# --- GitHub App ---
# Single-tenant mode: one app. Deployment uses TENANTS_JSON instead (below),
# which ignores these four variables.
# From: GitHub -> Settings -> Developer settings -> GitHub Apps -> your app
GITHUB_APP_ID=123456
# Installation id of the app on the target account.
GITHUB_APP_INSTALLATION_ID=12345678
# PEM private key. Paste the whole key on one line, using \n for newlines.
GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----
# From: GitHub App -> Webhooks -> Webhook secret
GITHUB_APP_WEBHOOK_SECRET=your-webhook-secret

# --- Multi-tenant registry (optional, takes precedence over the four above) ---
# One entry per GitHub App installation, in route order: the first tenant owns
# the legacy /webhook path, every tenant answers on /webhook/<key>. The registry
# is not secret and lives in the deployment configuration repository; each entry
# names the environment variables that hold that tenant's private key and
# webhook secret, so the secret values themselves never appear here.
# TENANTS_JSON=[{"key":"stackmon","org":"stackmon","appId":"5135070","installationId":166516466,"slug":"ecosquad-autoreview","privateKeyEnv":"GITHUB_APP_PRIVATE_KEY","webhookSecretEnv":"GITHUB_APP_WEBHOOK_SECRET"}]
# Organization used by the legacy single-tenant variables (optional).
# GITHUB_ORG=stackmon

# --- LLM (OpenAI-compatible) ---
LLM_BASE_URL=https://your-llm-gateway/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=your-model-name

# --- Server ---
# HOST=127.0.0.1
# PORT=8090
# debug, info, warn, error
# LOG_LEVEL=info

# --- Review behaviour ---
# Approve the pull request when the review did not request changes.
# AUTO_APPROVE=true
# author_association values allowed to start a review by mentioning the bot.
# TRUSTED_ASSOCIATIONS=OWNER,MEMBER
# Bot logins allowed to trigger automatic reviews without organization membership.
# AUTO_REVIEW_BOTS=dependabot[bot],renovate[bot]
# Review pull requests opened from a fork.
# REVIEW_FORK_PRS=false
# Where pull request branches are checked out for reading.
# WORKSPACE_ROOT=workspaces
# LLM tool loop budget.
# MAX_AGENT_STEPS=12
# Hard limit for a single review.
# RUN_TIMEOUT_MS=1800000
